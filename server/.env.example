# Change Pilot Agent Server configuration
# Copy this file to ../.env and replace the development token.
CHANGE_PILOT_API_TOKEN=replace-with-a-long-random-token

# Optional: defaults to $HOME/.claude/skills/change-pilot when present.
# CHANGE_PILOT_SKILL_DIR=/absolute/path/to/change-pilot

# Optional listener and runtime settings.
# CHANGE_PILOT_HOST=0.0.0.0
# CHANGE_PILOT_PORT=8080
# CHANGE_PILOT_AGENT_TIMEOUT=180
# CHANGE_PILOT_MAX_REQUEST_BYTES=102400
