# Change Pilot Agent Server configuration
# Copy this file to ../.env and replace the development token (and fill the
# model provider block below before serving real traffic).
CHANGE_PILOT_API_TOKEN=replace-with-a-long-random-token

# Optional: defaults to $HOME/.claude/skills/change-pilot when present.
# CHANGE_PILOT_SKILL_DIR=/absolute/path/to/change-pilot

# --- Model provider (OpenAI-compatible Chat Completions) ---
# Point these at MiniMax, DeepSeek, Qwen, or any OpenAI-compatible endpoint.
# Only URL + API key + model are required to switch providers. Secrets live
# here in the environment — never commit them, and never hardcode them.
# CHANGE_PILOT_BASE_URL=https://api.example.com/v1
# CHANGE_PILOT_API_KEY=replace-with-your-provider-api-key
# CHANGE_PILOT_MODEL=your-model-name
#
# Optional runtime tuning for the provider call:
# CHANGE_PILOT_MAX_TOKENS=1024
# CHANGE_PILOT_PROVIDER_TIMEOUT=60
# CHANGE_PILOT_RETRY_COUNT=1
# CHANGE_PILOT_MAX_CONCURRENCY=4

# Optional listener and runtime settings.
# CHANGE_PILOT_HOST=0.0.0.0
# CHANGE_PILOT_PORT=8080
# CHANGE_PILOT_AGENT_TIMEOUT=180
# CHANGE_PILOT_MAX_REQUEST_BYTES=102400